              <elementProp name="relampo_token" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">true</boolProp>
                <stringProp name="Argument.name">relampo_token</stringProp>
                <stringProp name="Argument.value">${relampo_token_b}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <boolProp name="HTTPArgument.use_equals">true</boolProp>
              </elementProp>
            </collectionProp>
          </elementProp>
          <stringProp name="HTTPSampler.path">/pay/start</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
        </HTTPSamplerProxy>
        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Transformar relampo_token (A -&gt; B)" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">// PASO 1 - Leer el token extraido en el request anterior
def tokenA = vars.get("relampo_token_a")

// PASO 2 - Transformarlo (misma logica que app.js en el navegador)
def salt = "relampo-public-salt-v1"
def tokenB = new StringBuilder()

for (int i = 0; i &lt; tokenA.length(); i++) {
    int x = ((int) tokenA.charAt(i)) ^ ((int) salt.charAt(i % salt.length()))
    tokenB.append(String.format("%02x", x))
}

// PASO 3 - Guardarlo para usarlo en el body como ${relampo_token_b}
vars.put("relampo_token_b", tokenB.toString())</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
          <RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor" testname="state (header Location, queda URL-encoded)" enabled="true">
            <stringProp name="RegexExtractor.useHeaders">true</stringProp>
            <stringProp name="RegexExtractor.refname">state</stringProp>
            <stringProp name="RegexExtractor.regex">(?i)Location:[^\r\n]*[?&amp;]state=([^&amp;\r\n]+)</stringProp>
            <stringProp name="RegexExtractor.template">$1$</stringProp>
            <stringProp name="RegexExtractor.default">STATE_NO_ENCONTRADO</stringProp>
            <stringProp name="RegexExtractor.match_number">1</stringProp>
          </RegexExtractor>
          <hashTree/>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Responde 302" enabled="true">
